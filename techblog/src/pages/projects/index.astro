        name: 'Daimler VECTO',
        description: 'Vehicle energy consumption and CO2 emissions calculation tool.',
        links: [
          { type: 'site', href: 'https://www.daimlertruck.com/en/newsroom/pressrelease/transparency-on-fuel-consumption-and-co2-emissions-daimler-trucks-welcomes-uniform-vecto-procedure-42082961' }

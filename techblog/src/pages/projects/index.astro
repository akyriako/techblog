---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'open', text: 'Open Source' },
  { depth: 2, slug: 'closed', text: 'Closed Source' },
]
---

<PageLayout title='Projects' {headings} view>
  <p>
  Here's what I've been up to, for better or worse! A collection of professional projects
  I've been paid to deliver, alongside personal experiments
  nobody in their right mind would fund.

  Some solve real business problems. Others create entirely
  new ones. I'll let you work out which is which.
</p>

  <h2 id='open'>Open Source</h2>
  <ProjectSection
    projects={[
      {
        name: 'Typesense Kubernetes Operator (TyKO)',
        description: 'Manage highly available Typesense clusters on Kubernetes.',
        links: [
          { type: 'site', href: 'https://akyriako.github.io/typesense-operator-docs/' },
          { type: 'doc', href: 'blog/deploy-typesense-on-kubernetes' },
          { type: 'github', href: 'https://github.com/akyriako/typesense-operator' },
          { type: 'release', href: 'https://github.com/akyriako/typesense-operator/releases' },
        ]
      },
      {
        name: 'o7k',
        description: 'OpenStack TUI, a clone of K9s but for OpenStack.',
        links: [
          { type: 'github', href: 'https://github.com/akyriako/o7k' },
          { type: 'release', href: 'https://github.com/akyriako/o7k/releases' }
        ]
      },
       {
        name: 'cert-manager-webhook-opentelekomcloud',
        description: 'ACME DNS01 solver webhook for Open Telekom Cloud DNS.',
        links: [
          { type: 'github', href: 'https://github.com/akyriako/cert-manager-webhook-opentelekomcloud' },
          { type: 'release', href: 'https://github.com/akyriako/cert-manager-webhook-opentelekomcloud/releases' }
        ]
      },
        {
        name: 'external-dns-opentelekomcloud-webhook',
        description: 'ExternalDNS - Open Telekom Cloud DNS Webhook.',
        links: [
          { type: 'github', href: 'https://github.com/akyriako/external-dns-opentelekomcloud-webhook' },
          { type: 'release', href: 'https://github.com/akyriako/external-dns-opentelekomcloud-webhook/releases' }
        ]
      },
       {
        name: 'typesense-prometheus-exporter',
        description: 'Prometheus exporter for Typesense metrics.',
        links: [
          { type: 'github', href: 'https://github.com/akyriako/typesense-prometheus-exporter' },
          { type: 'release', href: 'https://github.com/akyriako/typesense-prometheus-exporter/releases' }
        ]
      },
       {
        name: 'typesense-healthcheck',
        description: 'A lightweight Go service that reports the aggregated health status of a Typesense cluster.',
        links: [
          { type: 'github', href: 'https://github.com/akyriako/typesense-healthcheck' },
          { type: 'release', href: 'https://github.com/akyriako/typesense-healthcheck/releases' }
        ]
      }
      ,
       {
        name: 'rekuberate-io/sleepcycles',
        description: 'Define sleep & wake up cycles for your Kubernetes resources.',
        links: [
          { type: 'github', href: 'https://github.com/rekuberate-io/sleepcycles' },
          { type: 'release', href: 'https://github.com/rekuberate-io/sleepcycles/releases' }
        ]
      }
    ]}
  />
